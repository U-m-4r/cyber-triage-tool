# Copy to .env at the repository root. Never commit credentials.
APP_ENV=development
FLASK_DEBUG=false
DB_MODE=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=cyber_triage
MONGO_TIMEOUT_MS=1500
# Empty is allowed only for local development; production requires a token.
CYBER_TRIAGE_API_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONTENT_LENGTH=134217728
# Optional reputation providers; leave unset for offline work.
OTX_API_KEY=
VT_API_KEY=
# Tests ignore MONGO_URI/MONGO_DB. Integration uses only this dedicated endpoint.
TEST_MONGO_URI=mongodb://127.0.0.1:27018
